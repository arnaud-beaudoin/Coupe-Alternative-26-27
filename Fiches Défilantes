<!DOCTYPE html>

<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Carrousel + Objets spéciaux</title>

<style>

/* =========================================
   BASE
========================================= */

*{
  box-sizing:border-box;
}

html,
body{
  margin:0;
  padding:0;

  width:100%;
  min-height:100%;

  background:transparent;

  font-family:Arial,sans-serif;
}


/* =========================================
   CARROUSEL
========================================= */

.image-scroll-wrapper{
  width:100%;

  overflow:hidden;

  padding:20px 10px;

  cursor:grab;

  user-select:none;
  -webkit-user-select:none;

  touch-action:none;
}

.image-scroll-wrapper.dragging{
  cursor:grabbing;
}


/* =========================================
   BANDEAU
========================================= */

.image-scroll{
  display:flex;

  align-items:center;

  gap:80px;

  width:max-content;

  will-change:transform;
}


/* =========================================
   FICHES DU CARROUSEL
========================================= */

.image-card{
  position:relative;

  width:640px;

  flex-shrink:0;
}

.image-card img{
  width:100%;
  height:auto;

  display:block;

  border-radius:0;

  box-shadow:
    0 10px 30px rgba(0,0,0,0.45);

  user-select:none;
  -webkit-user-drag:none;

  pointer-events:none;
}


/* =========================================
   ZONE CLIQUABLE
   TOUTE LA FICHE
========================================= */

.click-zone{
  position:absolute;

  left:0;
  top:0;

  width:100%;
  height:100%;

  display:block;

  background:transparent;

  cursor:pointer;

  z-index:10;

  touch-action:auto;
}


/* =========================================
   SECTION OBJETS SPÉCIAUX
========================================= */

#specialObjects{

  display:none;

  width:100%;

  padding:20px 0 40px;

  background:#000000;

  overflow:hidden;
}


/* =========================================
   CONTENEUR DES FICHES
========================================= */

.cards-container{

  width:1330px;

  max-width:100%;

  display:flex;

  flex-direction:row;

  justify-content:center;

  align-items:center;

  gap:10px;

  margin:0 auto;

  background:#000000;
}


/* =========================================
   FICHE
========================================= */

.card{

  position:relative;

  width:157px;

  aspect-ratio:10.947 / 20;

  flex-shrink:0;

  perspective:1000px;

  opacity:0;

  transform:
    translateY(30px)
    scale(0.75);

}


/* =========================================
   FICHE APPARUE
========================================= */

.card.card-visible{

  animation:
    cardPop
    0.7s
    cubic-bezier(0.2,0.9,0.25,1.2)
    forwards;

}


/* =========================================
   ANIMATION POP
========================================= */

@keyframes cardPop{

  0%{

    opacity:0;

    transform:
      translateY(30px)
      scale(0.75);

  }

  45%{

    opacity:1;

    transform:
      translateY(-8px)
      scale(1.08);

  }

  70%{

    transform:
      translateY(3px)
      scale(0.98);

  }

  100%{

    opacity:1;

    transform:
      translateY(0)
      scale(1);

  }

}


/* =========================================
   ONDE BLANCHE
========================================= */

.card::before{

  content:"";

  position:absolute;

  left:50%;
  top:50%;

  width:30px;
  height:30px;

  border-radius:50%;

  border:3px solid rgba(255,255,255,0.95);

  box-shadow:
    0 0 8px rgba(255,255,255,0.95),
    0 0 18px rgba(255,255,255,0.7);

  transform:
    translate(-50%,-50%)
    scale(0);

  opacity:0;

  pointer-events:none;

  z-index:20;

}


/* =========================================
   ANIMATION DE L'ONDE
========================================= */

.card.card-visible::before{

  animation:
    waterWave
    0.85s
    ease-out
    forwards;

}


@keyframes waterWave{

  0%{

    width:25px;
    height:25px;

    opacity:0.95;

    border-width:4px;

    transform:
      translate(-50%,-50%)
      scale(0);

  }

  35%{

    opacity:0.9;

  }

  70%{

    opacity:0.45;

  }

  100%{

    width:300px;
    height:300px;

    opacity:0;

    border-width:1px;

    transform:
      translate(-50%,-50%)
      scale(1);

  }

}


/* =========================================
   DEUXIÈME PETITE ONDE
========================================= */

.card.card-visible::after{

  content:"";

  position:absolute;

  left:50%;
  top:50%;

  width:20px;
  height:20px;

  border-radius:50%;

  border:2px solid rgba(255,255,255,0.7);

  transform:
    translate(-50%,-50%)
    scale(0);

  opacity:0;

  pointer-events:none;

  z-index:19;

  animation:
    waterWaveSmall
    0.9s
    0.15s
    ease-out
    forwards;

}


@keyframes waterWaveSmall{

  0%{

    width:20px;
    height:20px;

    opacity:0.8;

    transform:
      translate(-50%,-50%)
      scale(0);

  }

  100%{

    width:230px;
    height:230px;

    opacity:0;

    transform:
      translate(-50%,-50%)
      scale(1);

  }

}


/* =========================================
   ÉLÉMENT QUI PIVOTE
========================================= */

.card-inner{

  position:relative;

  width:100%;
  height:100%;

  transition:
    transform 0.45s ease;

  transform-style:preserve-3d;

}


/* =========================================
   ROTATION AU SURVOL
========================================= */

.card:hover .card-inner{

  transform:
    rotateY(180deg);

}


/* =========================================
   RECTO ET VERSO
========================================= */

.card-front,
.card-back{

  position:absolute;

  width:100%;
  height:100%;

  top:0;
  left:0;

  overflow:hidden;

  border-radius:10px;

  backface-visibility:hidden;

  -webkit-backface-visibility:hidden;

  box-shadow:
    0 5px 12px rgba(255,255,255,0.15);

}


/* =========================================
   RECTO
========================================= */

.card-front{

  background:#000000;

}


/* =========================================
   VERSO
========================================= */

.card-back{

  background:#000000;

  transform:
    rotateY(180deg);

}


/* =========================================
   IMAGES
========================================= */

.card-front img,
.card-back img{

  width:100%;
  height:100%;

  display:block;

  object-fit:cover;

}


/* =========================================
   PETITS ÉCRANS
========================================= */

@media(max-width:1330px){

  .cards-container{

    overflow-x:auto;

    justify-content:flex-start;

    padding-left:10px;

    padding-right:10px;

    background:#000000;

  }

}


/* =========================================
   MOBILE
========================================= */

@media(max-width:700px){

  .image-scroll{

    gap:40px;

  }

  .image-card{

    width:520px;

  }

}


/* =========================================
   FIN CSS
========================================= */

</style>

