<script>

/* =========================================
   ÉLÉMENTS
========================================= */

const wrapper =
  document.getElementById("scrollWrapper");

const track =
  document.getElementById("imageTrack");

const specialObjects =
  document.getElementById("specialObjects");

const cards =
  document.querySelectorAll(
    "#specialObjects .card"
  );


/* =========================================
   DUPLICATION DU CARROUSEL
========================================= */

track.innerHTML += track.innerHTML;


/* =========================================
   CLIC OBJETS SPÉCIAUX
========================================= */

track.addEventListener(
  "click",
  function(event){

    const button =
      event.target.closest(
        ".special-objects-button"
      );

    if(!button){

      return;

    }

    event.preventDefault();


    /* -------------------------------------
       Affiche la section
    ------------------------------------- */

    specialObjects.style.display =
      "block";


    /* -------------------------------------
       Remet toutes les fiches à leur
       état initial
    ------------------------------------- */

    cards.forEach(function(card){

      card.classList.remove(
        "card-visible"
      );

    });


    /* -------------------------------------
       Apparition une par une
    ------------------------------------- */

    cards.forEach(function(card,index){

      setTimeout(
        function(){

          card.classList.add(
            "card-visible"
          );

        },

        index * 250

      );

    });

  }
);


/* =========================================
   VARIABLES DU CARROUSEL
========================================= */

let position = 0;

const speed = 1.5;

let animationFrame = null;

let isDragging = false;

let startX = 0;

let startPosition = 0;


/* =========================================
   LARGEUR D'UNE BOUCLE
========================================= */

function getLoopWidth(){

  return track.scrollWidth / 2;

}


/* =========================================
   NORMALISATION
========================================= */

function normalizePosition(){

  const width =
    getLoopWidth();

  while(position <= -width){

    position += width;

  }

  while(position > 0){

    position -= width;

  }

}


/* =========================================
   AFFICHAGE
========================================= */

function render(){

  track.style.transform =
    `translate3d(${position}px,0,0)`;

}


/* =========================================
   AUTO-DÉFILEMENT
========================================= */

function autoScroll(){

  if(!isDragging){

    position -= speed;

    normalizePosition();

    render();

  }

  animationFrame =
    requestAnimationFrame(autoScroll);

}


/* =========================================
   DÉBUT DU GLISSEMENT
========================================= */

function startDrag(x){

  isDragging = true;

  startX = x;

  startPosition = position;

  wrapper.classList.add("dragging");

}


/* =========================================
   DÉPLACEMENT
========================================= */

function moveDrag(x){

  if(!isDragging){

    return;

  }

  const movement =
    x - startX;

  position =
    startPosition + movement;

  normalizePosition();

  render();

}


/* =========================================
   FIN DU GLISSEMENT
========================================= */

function stopDrag(){

  if(!isDragging){

    return;

  }

  isDragging = false;

  wrapper.classList.remove("dragging");

}


/* =========================================
   SOURIS
========================================= */

wrapper.addEventListener(
  "mousedown",
  function(event){

    if(
      event.target.closest(".click-zone")
    ){

      return;

    }

    startDrag(
      event.clientX
    );

    event.preventDefault();

  }
);


window.addEventListener(
  "mousemove",
  function(event){

    if(!isDragging){

      return;

    }

    moveDrag(
      event.clientX
    );

  }
);


window.addEventListener(
  "mouseup",
  function(){

    stopDrag();

  }
);


/* =========================================
   TACTILE
========================================= */

wrapper.addEventListener(
  "touchstart",
  function(event){

    if(
      event.touches.length !== 1
    ){

      return;

    }

    if(
      event.target.closest(".click-zone")
    ){

      return;

    }

    startDrag(
      event.touches[0].clientX
    );

  },
  {passive:true}
);


wrapper.addEventListener(
  "touchmove",
  function(event){

    if(!isDragging){

      return;

    }

    if(
      event.touches.length !== 1
    ){

      return;

    }

    moveDrag(
      event.touches[0].clientX
    );

  },
  {passive:true}
);


wrapper.addEventListener(
  "touchend",
  function(){

    stopDrag();

  },
  {passive:true}
);


wrapper.addEventListener(
  "touchcancel",
  function(){

    stopDrag();

  },
  {passive:true}
);


/* =========================================
   EMPÊCHE LE DRAG NATIF
========================================= */

wrapper.addEventListener(
  "dragstart",
  function(event){

    event.preventDefault();

  }
);


/* =========================================
   DÉMARRAGE
========================================= */

render();

autoScroll();

</script>

