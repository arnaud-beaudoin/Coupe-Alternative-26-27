<title>Coupe Alternative 2026-2027</title>

<style>

/* =========================================================
   BASE
========================================================= */

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: black;
    font-family: Arial, sans-serif;
}


/* =========================================================
   CARTE
========================================================= */

#map {

    position: relative;

    width: 100vw;
    height: 100vh;

    background-image:
        url("https://github.com/arnaud-beaudoin/Coupe-Alternative-26-27/blob/main/Carte%2010.1%20Mini-COGE.png?raw=true");

    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;

    perspective: 1000px;

    overflow: hidden;
}


#map::after {

    content: "";

    position: absolute;

    inset: 0;

    background:
        radial-gradient(
            circle,
            transparent 45%,
            rgba(0,0,0,.35)
        );

    pointer-events: none;

    z-index: 1;
}


/* =========================================================
   ZONES CLIQUABLES
========================================================= */

:root {

    /*
       MODIFIER ICI L'OPACITÉ DES POLYGONES

       0    = invisible
       0.25 = légèrement transparent
       0.45 = rouge visible avec la carte derrière
       0.75 = très rouge
       1    = rouge complètement opaque
    */

    --OPACITE_ZONES: 0;
}


.zone-cliquable {

    position: absolute;

    left: 0;
    top: 0;

    width: 100%;
    height: 100%;

    background:
        rgba(
            255,
            0,
            0,
            var(--OPACITE_ZONES)
        );

    border:
        3px solid
        rgba(
            255,
            0,
            0,
            var(--OPACITE_ZONES)
        );

    cursor: pointer;

    z-index: 2;
}


/* =========================================================
   POLYGONE 1 — TRAITE MEUH-MEUH
========================================================= */

#zoneMeuh {

    clip-path: polygon(

        35.24% 63.52%,
        44.58% 51.99%,
        51.68% 66.42%,
        44.58% 71.22%

    );
}


/* =========================================================
   POLYGONE 2 — PÊCHE AQUAZO
========================================================= */

#zoneAquazo {

    clip-path: polygon(

        65.78% 65.47%,
        77.53% 54.93%,
        84.57% 65.47%,
        87% 75%,
        77.53% 71.22%

    );
}


/* =========================================================
   POLYGONE 3 — DÉSERT DODO

   Coordonnées cartésiennes :

   (17,20)
   (18,24)
   (23,26.5)
   (28,24)
   (24,19)

   Dimensions :
   largeur  = 59.16
   hauteur  = 28.99

   Origine :
   (0,0) = bas gauche
========================================================= */

#zoneDesertDodo {

    clip-path: polygon(

        28.74% 31.05%,
        30.43% 17.21%,
        38.88% 8.62%,
        47.33% 17.21%,
        40.57% 34.46%

    );
}


/* =========================================================
   POLYGONE 4 — BOWSER NINJA

   Coordonnées cartésiennes :

   (45,22)
   (50.5,26)
   (57,20)
   (52,17)
========================================================= */

#zoneBowserNinja {

    clip-path: polygon(

        76.06% 24.11%,
        85.36% 10.38%,
        96.35% 31.05%,
        87.90% 41.36%

    );
}


/* =========================================================
   ÉQUIPES / PILOTES
========================================================= */

.team {

    position: absolute;

    transform:
        translate(-50%, -50%);

    width: 48px;
    height: 48px;

    cursor: pointer;

    z-index: 5;
}


/* =========================================================
   PRIORITÉ AU SURVOL
========================================================= */

.team:hover {

    z-index: 2147483647 !important;

}


.team:hover .team-info {

    z-index: 2147483647 !important;

}


/* =========================================================
   BADGE
========================================================= */

.badge {

    width: 48px;
    height: 48px;

    object-fit: contain;

    display: block;

    border-radius: 50%;

    border: 2px solid black;

    background: white;
}


/* =========================================================
   BADGE SPÉCIAL — 3 ÉQUIPES OU PLUS
========================================================= */

.team.multiple-position .badge {

    background: white;

    border-radius: 50%;

    object-fit: contain;

    padding: 0;
}


/* =========================================================
   FICHE AU SURVOL
========================================================= */

.team-info {

    position: absolute;

    left: 58px;
    top: 50%;

    transform:
        translateY(-50%);

    min-width: 155px;

    padding: 8px 11px;

    border-radius: 10px;

    background:
        rgba(255,255,255,.95);

    border: 2px solid black;

    box-shadow:
        0 4px 12px rgba(0,0,0,.35);

    opacity: 0;

    visibility: hidden;

    pointer-events: none;

    white-space: nowrap;

    z-index: 2147483647;
}


.team:hover .team-info {

    opacity: 1;

    visibility: visible;

}


/* =========================================================
   FICHE GROUPES
========================================================= */

.team.multiple-position .team-info {

    display: block;

    min-width: 190px;

    white-space: normal;

}


/* =========================================================
   NOMS DES JOUEURS
========================================================= */

.team-group-title {

    font-size: 15px;

    font-weight: 800;

    margin-bottom: 6px;

}


.team-group-names {

    font-size: 14px;

    font-weight: 600;

    line-height: 1.4;

}


.team-group-names div {

    margin-bottom: 2px;

}


/* =========================================================
   FICHE VERS LE BAS
========================================================= */

.team.info-down .team-info {

    top: 58px;

    left: 50%;

    transform:
        translateX(-50%);
}


/* =========================================================
   INFORMATIONS
========================================================= */

.team-name {

    font-size: 15px;

    font-weight: 800;

    margin-bottom: 4px;
}


.team-rank {

    font-size: 12px;

    opacity: .75;
}


.team-score {

    font-size: 20px;

    font-weight: 800;

    margin-top: 2px;
}


.team-laps {

    font-size: 13px;

    font-weight: 700;

    margin-top: 3px;
}


/* =========================================================
   PODIUM
========================================================= */

.gold {

    box-shadow:
        0 0 0 2px gold,
        0 0 12px gold;
}


.silver {

    box-shadow:
        0 0 0 2px silver,
        0 0 12px silver;
}


.bronze {

    box-shadow:
        0 0 0 2px #cd7f32,
        0 0 12px #cd7f32;
}


/* =========================================================
   IMAGE CENTRALE
========================================================= */

.center-image {

    position: absolute;

    top: 46%;
    left: 60%;

    transform:
        translate(-50%,-50%);

    width: 140px;

    z-index: 10;

    cursor: pointer;
}


/* =========================================================
   PLUIE DE PIÈCES
   SEULE ANIMATION CONSERVÉE
========================================================= */

.coin-rain {

    position: fixed;

    width: 50px;
    height: 50px;

    pointer-events: none;

    z-index: 9999;

    animation:
        coinFall 4.5s linear forwards;
}


@keyframes coinFall {

    0% {

        opacity: 0;

        transform:
            translate(0,0)
            rotate(0)
            scale(1.5);
    }

    5% {

        opacity: 1;
    }

    100% {

        transform:
            translate(var(--dx),var(--dy))
            rotate(1440deg)
            scale(2.5);
    }

}

</style>

