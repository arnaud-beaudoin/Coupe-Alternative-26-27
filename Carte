/* =========================================================
   CONVERSION COORDONNÉES
========================================================= */

function coordToScreen(x, y) {

    return {

        left:
            (x / LARGEUR_IMAGE) * 100
            + DECALAGE_X,

        top:
            100 -
            (y / HAUTEUR_IMAGE) * 100

    };

}


/* =========================================================
   POSITION SUR LA PISTE
========================================================= */

function positionSurPiste(score) {

    const POINTS_PAR_TOUR = 30;

    const progression =
        (
            score % POINTS_PAR_TOUR
        )
        / POINTS_PAR_TOUR;

    const position =
        progression * piste.length;

    const index =
        Math.floor(position)
        % piste.length;

    const suivant =
        (index + 1)
        % piste.length;

    const fraction =
        position -
        Math.floor(position);

    const p1 =
        piste[index];

    const p2 =
        piste[suivant];

    const x =
        p1[0] +
        (
            p2[0] -
            p1[0]
        )
        * fraction;

    const y =
        p1[1] +
        (
            p2[1] -
            p1[1]
        )
        * fraction;

    return coordToScreen(x, y);

}


/* =========================================================
   POSITION DISCRÈTE
========================================================= */

function positionCle(score) {

    const POINTS_PAR_TOUR = 30;

    return Math.round(
        score % POINTS_PAR_TOUR
    );

}


/* =========================================================
   POSITION DES GROUPES
========================================================= */

function appliquerPositionGroupe(
    teamData,
    indexDansGroupe,
    tailleGroupe
) {

    const position =
        positionSurPiste(
            teamData.score
        );


    if (
        tailleGroupe >= 3
    ) {

        return {

            left:
                position.left,

            top:
                position.top

        };

    }


    if (
        tailleGroupe === 1
    ) {

        return {

            left:
                position.left,

            top:
                position.top

        };

    }


    const ECART_PX = 52;

    const ecartPourcent =
        (
            ECART_PX /
            window.innerWidth
        ) * 100;

    const decalage =
        (
            indexDansGroupe -
            (tailleGroupe - 1) / 2
        )
        * ecartPourcent;

    return {

        left:
            position.left +
            decalage,

        top:
            position.top

    };

}


/* =========================================================
   AFFICHAGE DES ÉQUIPES
========================================================= */

function renderTeam(
    teamData,
    indexDansGroupe = 0,
    tailleGroupe = 1
) {

    let el =
        elCache.get(
            teamData.name
        );


    if (!el) {

        el =
            document.createElement("div");

        el.className =
            "team";

        el.innerHTML = `

            <img
                class="badge"
                alt=""
            >

            <div class="team-info">

                <div class="team-name"></div>

                <div class="team-rank"></div>

                <div class="team-score"></div>

                <div class="team-laps"></div>

                <div class="team-group-names"></div>

            </div>

        `;

        map.appendChild(el);

        elCache.set(
            teamData.name,
            el
        );

    }


    el.classList.remove(
        "multiple-position"
    );


    if (
        tailleGroupe >= 3
    ) {

        el.classList.add(
            "multiple-position"
        );

    }


    const position =
        appliquerPositionGroupe(
            teamData,
            indexDansGroupe,
            tailleGroupe
        );


    el.style.left =
        position.left + "%";

    el.style.top =
        position.top + "%";


    el.classList.remove(
        "info-down"
    );


    const positionPiste =
        positionCle(
            teamData.score
        );


    if (
        tailleGroupe < 3 &&
        positionPiste >= 13 &&
        positionPiste <= 29
    ) {

        el.classList.add(
            "info-down"
        );

    }


    if (
        tailleGroupe >= 3
    ) {

        el.style.zIndex =
            100;

    }

    else if (
        positionPiste >= 13 &&
        positionPiste <= 29
    ) {

        el.style.zIndex =
            90;

    }

    else {

        el.style.zIndex =
            50 -
            Math.min(
                teamData.rank,
                40
            );

    }


    const badge =
        el.querySelector(
            ".badge"
        );


    badge.classList.remove(
        "gold",
        "silver",
        "bronze"
    );


    if (
        tailleGroupe >= 3
    ) {

        badge.src =
            "https://cdn-icons-png.flaticon.com/512/6325/6325609.png";

        badge.alt =
            "Plusieurs équipes à la même position";

    }

    else {

        badge.src =
            teamData.badge;

        badge.alt =
            "";


        if (
            teamData.rank === 1
        ) {

            badge.classList.add(
                "gold"
            );

        }

        else if (
            teamData.rank === 2
        ) {

            badge.classList.add(
                "silver"
            );

        }

        else if (
            teamData.rank === 3
        ) {

            badge.classList.add(
                "bronze"
            );

        }

    }


    if (
        tailleGroupe < 3
    ) {

        el.querySelector(
            ".team-name"
        ).textContent =
            teamData.name;


        el.querySelector(
            ".team-rank"
        ).textContent =
            "Rang " +
            teamData.rank;


        el.querySelector(
            ".team-score"
        ).textContent =
            teamData.score +
            " points";


        el.querySelector(
            ".team-laps"
        ).textContent =
            "Tours : " +
            teamData.laps;


        el.querySelector(
            ".team-group-names"
        ).innerHTML =
            "";

    }

    else {

        el.querySelector(
            ".team-name"
        ).textContent =
            "Position partagée";


        el.querySelector(
            ".team-rank"
        ).textContent =
            "Même position";


        el.querySelector(
            ".team-score"
        ).textContent =
            teamData.score +
            " points";


        el.querySelector(
            ".team-laps"
        ).textContent =
            "Tours : " +
            teamData.laps;


        const namesContainer =
            el.querySelector(
                ".team-group-names"
            );


        namesContainer.innerHTML =
            "<strong>Joueurs :</strong>";


        teamData.groupNames.forEach(
            name => {

                const nameElement =
                    document.createElement(
                        "div"
                    );

                nameElement.textContent =
                    "• " + name;

                namesContainer.appendChild(
                    nameElement
                );

            }
        );

    }

}


/* =========================================================
   CHARGEMENT GOOGLE SHEET
========================================================= */

async function load() {

    try {

        const response =
            await fetch(
                URL,
                {
                    cache: "no-store"
                }
            );


        if (!response.ok) {

            throw new Error(
                "Impossible de récupérer le Google Sheet."
            );

        }


        const data =
            await response.json();


        if (
            !Array.isArray(data) ||
            data.length === 0
        ) {

            console.warn(
                "Le Google Sheet ne contient aucune donnée."
            );

            return;

        }


        const nomsActuels =
            new Set();


        const teams =
            data
                .map(row => {

                    const cles =
                        Object.keys(row);


                    if (
                        cles.length === 0
                    ) {

                        return null;

                    }


                    const premiereColonne =
                        cles[0];


                    const name =
                        String(
                            row[premiereColonne]
                            ?? ""
                        ).trim();


                    if (!name) {

                        return null;

                    }


                    const scoreBrut =
                        Number(
                            row.Score ??
                            row.score ??
                            0
                        );


                    const score =
                        Number.isFinite(
                            scoreBrut
                        )
                        ? Math.max(
                            0,
                            scoreBrut
                        )
                        : 0;


                    const rankBrut =
                        Number(
                            row.Rang ??
                            row.rank ??
                            999
                        );


                    const rank =
                        Number.isFinite(
                            rankBrut
                        )
                        ? rankBrut
                        : 999;


                    const badge =
                        String(
                            row.badge ??
                            ""
                        ).trim();


                    const POINTS_PAR_TOUR = 30;


                    const laps =
                        Math.floor(
                            score /
                            POINTS_PAR_TOUR
                        );


                    nomsActuels.add(
                        name
                    );


                    return {

                        name:
                            name,

                        score:
                            score,

                        rank:
                            rank,

                        badge:
                            badge,

                        laps:
                            laps

                    };

                })
                .filter(
                    team =>
                        team !== null
                );


        /* =====================================================
           SUPPRESSION DES ANCIENNES ÉQUIPES
        ===================================================== */

        elCache.forEach(
            (
                element,
                name
            ) => {

                if (
                    !nomsActuels.has(name)
                ) {

                    element.remove();

                    elCache.delete(
                        name
                    );

                }

            }
        );


        /* =====================================================
           GROUPES
        ===================================================== */

        const groupes =
            new Map();


        teams.forEach(
            team => {

                const position =
                    positionCle(
                        team.score
                    );


                if (
                    !groupes.has(
                        position
                    )
                ) {

                    groupes.set(
                        position,
                        []
                    );

                }


                groupes
                    .get(
                        position
                    )
                    .push(
                        team
                    );

            }
        );


        /* =====================================================
           NOMS DES GROUPES
        ===================================================== */

        groupes.forEach(
            group => {

                if (
                    group.length >= 3
                ) {

                    const groupNames =
                        group.map(
                            team =>
                                team.name
                        );


                    group.forEach(
                        team => {

                            team.groupNames =
                                groupNames;

                        }
                    );

                }

            }
        );


        /* =====================================================
           AFFICHAGE
        ===================================================== */

        groupes.forEach(
            group => {

                group.forEach(
                    (
                        team,
                        index
                    ) => {

                        renderTeam(
                            team,
                            index,
                            group.length
                        );

                    }
                );

            }
        );

    }

    catch (error) {

        console.error(
            "Erreur lors du chargement du Sheet :",
            error
        );

    }

}


load();


setInterval(
    load,
    5000
);


