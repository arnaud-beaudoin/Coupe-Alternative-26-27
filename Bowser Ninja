<!DOCTYPE html>
<html lang="fr">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>Bowser Ninja</title>

<style>

/* =========================================================
   BASE
========================================================= */

* {
    box-sizing: border-box;
}

html,
body {

    margin: 0;
    padding: 0;

    width: 100%;
    height: 100%;

    overflow: hidden;

    background: black;

    font-family: Arial, sans-serif;

    user-select: none;
}


/* =========================================================
   ÉCRANS
========================================================= */

.screen {

    position: fixed;

    inset: 0;

    width: 100%;
    height: 100%;
}

.hidden {
    display: none !important;
}


/* =========================================================
   ÉCRAN D'ACCUEIL
========================================================= */

#homeScreen {

    z-index: 10;

    display: flex;

    justify-content: center;
    align-items: flex-end;

    padding-bottom: 8%;

    background-image:
        url(
            "https://github.com/arnaud-beaudoin/Coupe-Alternative-26-27/blob/main/Bowser%20Ninja.png?raw=true"
        );

    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
}


/* =========================================================
   BOUTON JOUER
========================================================= */

#startButton {

    border: none;

    padding: 18px 60px;

    font-size: 28px;
    font-weight: bold;

    color: white;

    background: #e53935;

    border-radius: 12px;

    cursor: pointer;

    box-shadow:
        0 6px 0 #8e1b19,
        0 10px 25px rgba(0,0,0,.5);

    transition:
        transform .1s ease,
        box-shadow .1s ease;
}

#startButton:active {

    transform: translateY(5px);

    box-shadow:
        0 1px 0 #8e1b19,
        0 4px 10px rgba(0,0,0,.5);
}


/* =========================================================
   ÉCRAN DU JEU
========================================================= */

#gameScreen {

    z-index: 1;

    background-image:
        url(
            "https://github.com/arnaud-beaudoin/Coupe-Alternative-26-27/blob/main/Bowser%20Ninja%20jeu.png?raw=true"
        );

    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
}


/* =========================================================
   CANVAS
========================================================= */

#gameCanvas {

    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    touch-action: none;

    cursor: none;

    display: block;
}


/* =========================================================
   HUD
========================================================= */

#hud {

    position: absolute;

    top: 20px;
    left: 20px;
    right: 20px;

    display: flex;

    justify-content: space-between;

    pointer-events: none;

    color: white;

    font-size: 24px;

    font-weight: bold;

    text-shadow:
        2px 2px 4px black,
        -1px -1px 2px black;
}

#score,
#timer {

    padding: 8px 15px;

    border-radius: 10px;

    background:
        rgba(0,0,0,.50);
}


/* =========================================================
   INSTRUCTIONS
========================================================= */

#instructions {

    position: absolute;

    left: 50%;
    bottom: 25px;

    transform:
        translateX(-50%);

    color: white;

    font-size: 18px;

    text-align: center;

    padding: 8px 15px;

    border-radius: 8px;

    background:
        rgba(0,0,0,.45);

    pointer-events: none;

    text-shadow:
        2px 2px 3px black;
}


/* =========================================================
   GAME OVER
========================================================= */

#gameOver {

    position: absolute;

    inset: 0;

    z-index: 20;

    display: flex;

    flex-direction: column;

    justify-content: center;
    align-items: center;

    color: white;

    text-align: center;

    background:
        rgba(0,0,0,.72);
}

#gameOver h1 {

    margin:
        0 0 15px;

    font-size: 60px;

    text-shadow:
        4px 4px 0 black;
}

#finalScore {

    margin-bottom: 30px;

    font-size: 28px;
}

#restartButton {

    border: none;

    padding: 15px 40px;

    font-size: 24px;

    font-weight: bold;

    color: white;

    background: #e53935;

    border-radius: 10px;

    cursor: pointer;
}


/* =========================================================
   CURSEUR
========================================================= */

#cursorDot {

    position: fixed;

    width: 12px;
    height: 12px;

    z-index: 100;

    display: none;

    border-radius: 50%;

    background: white;

    border: 2px solid black;

    pointer-events: none;

    transform:
        translate(-50%, -50%);
}

</style>

</head>


<body>


<!-- =====================================================
     ÉCRAN D'ACCUEIL
===================================================== -->

<div id="homeScreen"
     class="screen">

    <button id="startButton">
        JOUER
    </button>

</div>


<!-- =====================================================
     ÉCRAN DU JEU
===================================================== -->

<div id="gameScreen"
     class="screen hidden">

    <canvas id="gameCanvas"></canvas>


    <div id="hud">

        <div id="score">
            Score : 0
        </div>

        <div id="timer">
            Temps : 20.0
        </div>

    </div>


    <div id="instructions">
        Maintiens le clic et tranche les boules de feu !
    </div>


    <!-- ================================================
         GAME OVER
    ================================================= -->

    <div id="gameOver"
         class="hidden">

        <h1 id="gameOverTitle">
            GAME OVER
        </h1>

        <div id="finalScore">
            Score : 0
        </div>

        <button id="restartButton">
            REJOUER
        </button>

    </div>

</div>


<!-- Curseur de découpe -->

<div id="cursorDot"></div>


<script>

/* =========================================================
   ÉLÉMENTS HTML
========================================================= */

const homeScreen =
    document.getElementById("homeScreen");

const gameScreen =
    document.getElementById("gameScreen");

const startButton =
    document.getElementById("startButton");

const restartButton =
    document.getElementById("restartButton");

const canvas =
    document.getElementById("gameCanvas");

const ctx =
    canvas.getContext("2d", {
        alpha: true
    });

const scoreElement =
    document.getElementById("score");

const timerElement =
    document.getElementById("timer");

const gameOverElement =
    document.getElementById("gameOver");

const gameOverTitle =
    document.getElementById("gameOverTitle");

const finalScoreElement =
    document.getElementById("finalScore");

const cursorDot =
    document.getElementById("cursorDot");


/* =========================================================
   IMAGE DE LA BOULE DE FEU
========================================================= */

const fireballImage = new Image();

fireballImage.src =
    "https://github.com/arnaud-beaudoin/Coupe-Alternative-26-27/blob/main/Boule%20de%20Feu.png?raw=true";


/* =========================================================
   DIMENSIONS DU MONDE
========================================================= */

const GAME_WIDTH = 48.53;
const GAME_HEIGHT = 27.17;

const X_START = 10;
const X_END = 40;


/* =========================================================
   PARAMÈTRES DU JEU
========================================================= */

const GAME_DURATION = 20;

const INITIAL_SPAWN_INTERVAL = 800;

const MIN_SPAWN_INTERVAL = 360;

const SPAWN_ACCELERATION = 8;

const MAX_FIREBALLS = 8;


/* =========================================================
   PARAMÈTRES DES BOMBES
========================================================= */

/*
    Probabilité initiale qu'un nouvel objet
    soit une bombe.

    0.15 = 15 %
*/

const INITIAL_BOMB_CHANCE = 0.15;


/*
    Probabilité maximale.

    0.28 = 28 %
*/

const MAX_BOMB_CHANCE = 0.28;


/*
    Vitesse à laquelle la probabilité
    augmente pendant la partie.
*/

const BOMB_CHANCE_INCREASE = 0.005;


/*
    Nombre maximum de bombes simultanées.
*/

const MAX_BOMBS = 3;


/*
    Taille de base des bombes.
*/

const BOMB_SIZE_RATIO = 0.12;


/* =========================================================
   TRAJECTOIRES
========================================================= */

const trajectories = [

    {
        a: -0.030,
        h: 20,
        k: 25
    },

    {
        a: -0.026,
        h: 18.5,
        k: 24.5
    },

    {
        a: -0.034,
        h: 21.5,
        k: 25.5
    },

    {
        a: -0.022,
        h: 23,
        k: 23.8
    },

    {
        a: -0.030,
        h: 17,
        k: 24.2
    }

];


/* =========================================================
   TAILLES DES BOULES DE FEU
========================================================= */

const fireballSizes = [

    0.10,
    0.12,
    0.14,
    0.16,
    0.18

];


/* =========================================================
   VARIABLES DU JEU
========================================================= */

let score = 0;

let lives = 1;


/*
    Les boules de feu.
*/

let fireballs = [];


/*
    Les bombes.
*/

let bombs = [];


let particles = [];

let slashTrail = [];


let animationFrame = null;

let gameRunning = false;

let gameStartTime = 0;

let timeRemaining =
    GAME_DURATION;

let lastTimestamp = 0;


let spawnTimer = 0;

let spawnInterval =
    INITIAL_SPAWN_INTERVAL;


let isDragging = false;

let previousPointer = null;


let cursorX = 0;

let cursorY = 0;


/* =========================================================
   CANVAS HAUTE RÉSOLUTION
========================================================= */

function resizeCanvas() {

    const dpr =
        Math.min(
            window.devicePixelRatio || 1,
            2
        );


    canvas.width =
        Math.floor(
            window.innerWidth * dpr
        );


    canvas.height =
        Math.floor(
            window.innerHeight * dpr
        );


    canvas.style.width =
        window.innerWidth + "px";


    canvas.style.height =
        window.innerHeight + "px";


    ctx.setTransform(
        dpr,
        0,
        0,
        dpr,
        0,
        0
    );

}


window.addEventListener(
    "resize",
    resizeCanvas
);


resizeCanvas();


/* =========================================================
   CONVERSION DE COORDONNÉES
========================================================= */

function mathToScreen(x, y) {

    return {

        x:
            (x / GAME_WIDTH) *
            window.innerWidth,

        y:
            window.innerHeight -
            (
                y /
                GAME_HEIGHT
            ) *
            window.innerHeight

    };

}


/* =========================================================
   TRAJECTOIRE
========================================================= */

function trajectoryY(
    x,
    trajectory
) {

    return (
        trajectory.a *
        Math.pow(
            x - trajectory.h,
            2
        ) +
        trajectory.k
    );

}


/* =========================================================
   CLASSE BOULE DE FEU
========================================================= */

class Fireball {

    constructor() {

        this.x =
            X_START +
            Math.random() * 0.5;


        this.trajectory =
            trajectories[
                Math.floor(
                    Math.random() *
                    trajectories.length
                )
            ];


        this.sizeRatio =
            fireballSizes[
                Math.floor(
                    Math.random() *
                    fireballSizes.length
                )
            ];


        this.size =
            Math.min(
                window.innerWidth,
                window.innerHeight
            ) *
            this.sizeRatio;


        /*
            Vitesse toujours positive :
            GAUCHE → DROITE
        */

        this.speedX =
            8.5 +
            Math.random() *
            4.5;


        this.verticalOffset =
            (
                Math.random() -
                0.5
            ) *
            0.5;


        this.rotation =
            Math.random() *
            Math.PI *
            2;


        this.rotationSpeed =
            (
                Math.random() -
                0.5
            ) *
            3;


        this.active = true;

    }


    getScreenPosition() {

        let y =
            trajectoryY(
                this.x,
                this.trajectory
            );


        y +=
            this.verticalOffset;


        y =
            Math.max(
                0,
                Math.min(
                    GAME_HEIGHT,
                    y
                )
            );


        return mathToScreen(
            this.x,
            y
        );

    }


    update(deltaTime) {

        this.x +=
            this.speedX *
            deltaTime;


        this.rotation +=
            this.rotationSpeed *
            deltaTime;


        if (
            this.x >= X_END
        ) {

            this.active = false;


            const position =
                this.getScreenPosition();


            createMissParticles(
                position.x,
                position.y
            );


            loseLife();

        }

    }


    draw() {

        if (
            !fireballImage.complete
        ) {
            return;
        }


        const position =
            this.getScreenPosition();


        ctx.save();


        ctx.translate(
            position.x,
            position.y
        );


        ctx.rotate(
            this.rotation
        );


        ctx.drawImage(

            fireballImage,

            -this.size / 2,
            -this.size / 2,

            this.size,
            this.size

        );


        ctx.restore();

    }

}


/* =========================================================
   CLASSE BOMBE
========================================================= */

class Bomb {

    constructor() {

        /*
            Départ à gauche.
        */

        this.x =
            X_START +
            Math.random() * 0.5;


        /*
            Trajectoire aléatoire.
        */

        this.trajectory =
            trajectories[
                Math.floor(
                    Math.random() *
                    trajectories.length
                )
            ];


        /*
            Taille de la bombe.
        */

        this.size =
            Math.min(
                window.innerWidth,
                window.innerHeight
            ) *
            BOMB_SIZE_RATIO;


        /*
            Vitesse légèrement différente
            de celle des boules.
        */

        this.speedX =
            8 +
            Math.random() *
            4;


        /*
            Décalage vertical.
        */

        this.verticalOffset =
            (
                Math.random() -
                0.5
            ) *
            0.5;


        /*
            Rotation de la bombe.
        */

        this.rotation =
            Math.random() *
            Math.PI *
            2;


        this.rotationSpeed =
            (
                Math.random() -
                0.5
            ) *
            1.5;


        this.active = true;

    }


    /* =====================================================
       POSITION
    ===================================================== */

    getScreenPosition() {

        let y =
            trajectoryY(
                this.x,
                this.trajectory
            );


        y +=
            this.verticalOffset;


        y =
            Math.max(
                0,
                Math.min(
                    GAME_HEIGHT,
                    y
                )
            );


        return mathToScreen(
            this.x,
            y
        );

    }


    /* =====================================================
       MOUVEMENT
    ===================================================== */

    update(deltaTime) {

        this.x +=
            this.speedX *
            deltaTime;


        this.rotation +=
            this.rotationSpeed *
            deltaTime;


        /*
            Une bombe qui atteint la droite
            disparaît simplement.
        */

        if (
            this.x >= X_END
        ) {

            this.active = false;

        }

    }


    /* =====================================================
       AFFICHAGE DE LA BOMBE
    ===================================================== */

    draw() {

        if (
            !this.active
        ) {
            return;
        }


        const position =
            this.getScreenPosition();


        const s =
            this.size;


        ctx.save();


        ctx.translate(
            position.x,
            position.y
        );


        ctx.rotate(
            this.rotation
        );


        /* =================================================
           MÈCHE
        ================================================= */

        ctx.strokeStyle =
            "#d8b26a";

        ctx.lineWidth =
            Math.max(
                3,
                s * 0.08
            );

        ctx.lineCap =
            "round";


        ctx.beginPath();

        ctx.moveTo(
            -s * 0.10,
            -s * 0.42
        );

        ctx.quadraticCurveTo(

            -s * 0.30,
            -s * 0.65,

            -s * 0.08,
            -s * 0.82

        );

        ctx.stroke();


        /* =================================================
           ÉTINCELLE
        ================================================= */

        ctx.fillStyle =
            "#ffb300";

        ctx.beginPath();

        ctx.arc(

            -s * 0.08,
            -s * 0.82,

            s * 0.09,

            0,
            Math.PI * 2

        );

        ctx.fill();


        /* =================================================
           CORPS DE LA BOMBE
        ================================================= */

        ctx.fillStyle =
            "#171717";

        ctx.beginPath();

        ctx.arc(

            0,
            0,

            s * 0.42,

            0,
            Math.PI * 2

        );

        ctx.fill();


        /*
            Contour.
        */

        ctx.lineWidth =
            Math.max(
                2,
                s * 0.05
            );

        ctx.strokeStyle =
            "#555";

        ctx.stroke();


        /* =================================================
           BANDE SUR LA BOMBE
        ================================================= */

        ctx.strokeStyle =
            "#303030";

        ctx.lineWidth =
            s * 0.12;

        ctx.beginPath();

        ctx.arc(

            0,
            0,

            s * 0.42,

            Math.PI * 0.35,
            Math.PI * 1.35

        );

        ctx.stroke();


        ctx.restore();

    }

}


/* =========================================================
   CRÉER UNE BOULE DE FEU
========================================================= */

function spawnFireball() {

    if (
        fireballs.length >=
        MAX_FIREBALLS
    ) {
        return;
    }


    fireballs.push(
        new Fireball()
    );

}


/* =========================================================
   CRÉER UNE BOMBE
========================================================= */

function spawnBomb() {

    if (
        bombs.length >=
        MAX_BOMBS
    ) {
        return;
    }


    bombs.push(
        new Bomb()
    );

}


/* =========================================================
   CHOISIR ENTRE BOULE ET BOMBE
========================================================= */

function spawnObject() {

    /*
        La probabilité augmente progressivement.

        Au début :
        15 %

        À la fin :
        jusqu'à 28 %
    */

    const elapsed =
        GAME_DURATION -
        timeRemaining;


    const bombChance =
        Math.min(

            MAX_BOMB_CHANCE,

            INITIAL_BOMB_CHANCE +
            elapsed *
            BOMB_CHANCE_INCREASE

        );


    if (
        Math.random() <
        bombChance
        &&
        bombs.length <
        MAX_BOMBS
    ) {

        spawnBomb();

    }
    else {

        spawnFireball();

    }

}


/* =========================================================
   PARTICULES
========================================================= */

function createParticles(
    x,
    y
) {

    for (
        let i = 0;
        i < 22;
        i++
    ) {

        const angle =
            Math.random() *
            Math.PI *
            2;


        const speed =
            100 +
            Math.random() *
            300;


        particles.push({

            x: x,
            y: y,

            vx:
                Math.cos(angle) *
                speed,

            vy:
                Math.sin(angle) *
                speed,

            life:
                0.45 +
                Math.random() *
                0.25,

            size:
                3 +
                Math.random() *
                7

        });

    }

}


/* =========================================================
   PARTICULES D'ÉCHEC
========================================================= */

function createMissParticles(
    x,
    y
) {

    for (
        let i = 0;
        i < 10;
        i++
    ) {

        particles.push({

            x: x,
            y: y,

            vx:
                (
                    Math.random() -
                    0.5
                ) *
                150,

            vy:
                (
                    Math.random() -
                    0.5
                ) *
                150,

            life:
                0.25 +
                Math.random() *
                0.2,

            size:
                2 +
                Math.random() *
                4

        });

    }

}


/* =========================================================
   PARTICULES DE BOMBE
========================================================= */

function createBombExplosion(
    x,
    y
) {

    for (
        let i = 0;
        i < 45;
        i++
    ) {

        const angle =
            Math.random() *
            Math.PI *
            2;


        const speed =
            100 +
            Math.random() *
            400;


        particles.push({

            x: x,
            y: y,

            vx:
                Math.cos(angle) *
                speed,

            vy:
                Math.sin(angle) *
                speed,

            life:
                0.35 +
                Math.random() *
                0.45,

            size:
                3 +
                Math.random() *
                8

        });

    }

}


/* =========================================================
   UPDATE PARTICULES
========================================================= */

function updateParticles(
    deltaTime
) {

    for (
        let i =
            particles.length - 1;

        i >= 0;

        i--
    ) {

        const p =
            particles[i];


        p.x +=
            p.vx *
            deltaTime;


        p.y +=
            p.vy *
            deltaTime;


        p.vy +=
            350 *
            deltaTime;


        p.life -=
            deltaTime;


        if (
            p.life <= 0
        ) {

            particles.splice(
                i,
                1
            );

        }

    }

}


/* =========================================================
   DRAW PARTICULES
========================================================= */

function drawParticles() {

    for (
        const p of particles
    ) {

        ctx.globalAlpha =
            Math.max(
                0,
                p.life
            );


        ctx.fillStyle =
            "#ffb300";


        ctx.beginPath();


        ctx.arc(

            p.x,
            p.y,

            p.size,

            0,
            Math.PI * 2

        );


        ctx.fill();

    }


    ctx.globalAlpha = 1;

}


/* =========================================================
   DISTANCE POINT / SEGMENT
========================================================= */

function distanceToSegment(
    px,
    py,
    x1,
    y1,
    x2,
    y2
) {

    const dx =
        x2 - x1;

    const dy =
        y2 - y1;


    if (
        dx === 0 &&
        dy === 0
    ) {

        return Math.hypot(
            px - x1,
            py - y1
        );

    }


    const t =
        Math.max(
            0,
            Math.min(
                1,

                (
                    (px - x1) * dx +
                    (py - y1) * dy
                )
                /
                (
                    dx * dx +
                    dy * dy
                )

            )
        );


    const closestX =
        x1 +
        t * dx;


    const closestY =
        y1 +
        t * dy;


    return Math.hypot(
        px - closestX,
        py - closestY
    );

}


/* =========================================================
   COUPER UNE BOULE
========================================================= */

function sliceFireball(
    fireball
) {

    if (
        !fireball.active
    ) {
        return;
    }


    fireball.active =
        false;


    const position =
        fireball.getScreenPosition();


    createParticles(
        position.x,
        position.y
    );


    score++;


    updateHUD();

}


/* =========================================================
   TOUCHER UNE BOMBE
========================================================= */

function hitBomb(
    bomb
) {

    if (
        !bomb.active ||
        !gameRunning
    ) {
        return;
    }


    bomb.active =
        false;


    const position =
        bomb.getScreenPosition();


    createBombExplosion(
        position.x,
        position.y
    );


    /*
        La bombe provoque immédiatement
        la fin de la partie.
    */

    endGame(
        "BOUM !"
    );

}


/* =========================================================
   DÉTECTION DU COUP
========================================================= */

function checkSlice(
    x1,
    y1,
    x2,
    y2
) {

    if (
        !gameRunning
    ) {
        return;
    }


    /* =====================================================
       BOMBE EN PREMIER
    ===================================================== */

    for (
        let i =
            bombs.length - 1;

        i >= 0;

        i--
    ) {

        const bomb =
            bombs[i];


        if (
            !bomb.active
        ) {
            continue;
        }


        const position =
            bomb.getScreenPosition();


        const distance =
            distanceToSegment(

                position.x,
                position.y,

                x1,
                y1,

                x2,
                y2

            );


        /*
            Zone de collision légèrement
            plus grande que le dessin.

            Cela rend la bombe dangereuse
            sans exiger une précision parfaite.
        */

        const collisionRadius =
            bomb.size *
            0.48;


        if (
            distance <
            collisionRadius
        ) {

            hitBomb(
                bomb
            );


            return;

        }

    }


    /* =====================================================
       BOULES DE FEU
    ===================================================== */

    for (
        let i =
            fireballs.length - 1;

        i >= 0;

        i--
    ) {

        const fireball =
            fireballs[i];


        if (
            !fireball.active
        ) {
            continue;
        }


        const position =
            fireball.getScreenPosition();


        const distance =
            distanceToSegment(

                position.x,
                position.y,

                x1,
                y1,

                x2,
                y2

            );


        const collisionRadius =
            fireball.size *
            0.42;


        if (
            distance <
            collisionRadius
        ) {

            sliceFireball(
                fireball
            );

        }

    }

}


/* =========================================================
   TRAÎNÉE DE DÉCOUPE
========================================================= */

function addSlashTrail(
    x1,
    y1,
    x2,
    y2
) {

    slashTrail.push({

        x1,
        y1,

        x2,
        y2,

        life: 0.22

    });

}


/* =========================================================
   UPDATE TRAÎNÉE
========================================================= */

function updateSlashTrail(
    deltaTime
) {

    for (
        let i =
            slashTrail.length - 1;

        i >= 0;

        i--
    ) {

        slashTrail[i].life -=
            deltaTime;


        if (
            slashTrail[i].life <= 0
        ) {

            slashTrail.splice(
                i,
                1
            );

        }

    }

}


/* =========================================================
   AFFICHAGE TRAÎNÉE
========================================================= */

function drawSlashTrail() {

    ctx.save();

    ctx.lineCap =
        "round";


    for (
        const segment
        of slashTrail
    ) {

        const alpha =
            Math.max(
                0,
                segment.life / 0.22
            );


        ctx.globalAlpha =
            alpha;


        ctx.lineWidth = 10;

        ctx.strokeStyle =
            "rgba(0,0,0,.65)";


        ctx.beginPath();

        ctx.moveTo(
            segment.x1,
            segment.y1
        );

        ctx.lineTo(
            segment.x2,
            segment.y2
        );

        ctx.stroke();


        ctx.lineWidth = 4;

        ctx.strokeStyle =
            "white";


        ctx.beginPath();

        ctx.moveTo(
            segment.x1,
            segment.y1
        );

        ctx.lineTo(
            segment.x2,
            segment.y2
        );

        ctx.stroke();

    }


    ctx.restore();

}


/* =========================================================
   POINTER MOVE
========================================================= */

window.addEventListener(
    "pointermove",
    function(event) {

        cursorX =
            event.clientX;

        cursorY =
            event.clientY;


        cursorDot.style.left =
            cursorX + "px";


        cursorDot.style.top =
            cursorY + "px";


        if (
            gameRunning
        ) {

            cursorDot.style.display =
                "block";

        }


        if (
            !isDragging ||
            !previousPointer
        ) {
            return;
        }


        addSlashTrail(

            previousPointer.x,
            previousPointer.y,

            cursorX,
            cursorY

        );


        checkSlice(

            previousPointer.x,
            previousPointer.y,

            cursorX,
            cursorY

        );


        previousPointer = {

            x: cursorX,
            y: cursorY

        };

    }
);


/* =========================================================
   POINTER DOWN
========================================================= */

canvas.addEventListener(
    "pointerdown",
    function(event) {

        if (
            !gameRunning
        ) {
            return;
        }


        isDragging = true;


        previousPointer = {

            x: event.clientX,
            y: event.clientY

        };


        try {

            canvas.setPointerCapture(
                event.pointerId
            );

        }
        catch (error) {

            /* Rien à faire */

        }

    }
);


/* =========================================================
   POINTER UP
========================================================= */

function stopDragging() {

    isDragging = false;

    previousPointer = null;

}


canvas.addEventListener(
    "pointerup",
    stopDragging
);

canvas.addEventListener(
    "pointercancel",
    stopDragging
);

canvas.addEventListener(
    "pointerleave",
    function() {

        if (
            isDragging
        ) {
            return;
        }

        previousPointer = null;

    }
);


/* =========================================================
   PERDRE
========================================================= */

function loseLife() {

    if (
        !gameRunning
    ) {
        return;
    }


    lives = 0;


    endGame(
        "GAME OVER"
    );

}


/* =========================================================
   HUD
========================================================= */

function updateHUD() {

    scoreElement.textContent =
        "Score : " +
        score;


    timerElement.textContent =
        "Temps : " +
        Math.max(
            0,
            timeRemaining
        ).toFixed(1);

}


/* =========================================================
   FIN DE PARTIE
========================================================= */

function endGame(
    title
) {

    if (
        !gameRunning
    ) {
        return;
    }


    gameRunning = false;


    if (
        animationFrame !== null
    ) {

        cancelAnimationFrame(
            animationFrame
        );

        animationFrame = null;

    }


    gameOverTitle.textContent =
        title;


    finalScoreElement.textContent =
        "Score : " +
        score;


    gameOverElement.classList.remove(
        "hidden"
    );


    cursorDot.style.display =
        "none";


    isDragging = false;

    previousPointer = null;

}


/* =========================================================
   BOUCLE PRINCIPALE
========================================================= */

function gameLoop(
    timestamp
) {

    if (
        !gameRunning
    ) {
        return;
    }


    if (
        lastTimestamp === 0
    ) {

        lastTimestamp =
            timestamp;

    }


    const deltaTime =
        Math.min(
            (
                timestamp -
                lastTimestamp
            ) / 1000,

            0.035
        );


    lastTimestamp =
        timestamp;


    /* =====================================================
       TIMER
    ===================================================== */

    const elapsed =
        (
            timestamp -
            gameStartTime
        ) / 1000;


    timeRemaining =
        Math.max(
            0,
            GAME_DURATION -
            elapsed
        );


    updateHUD();


    if (
        timeRemaining <= 0
    ) {

        endGame(
            "Partie Terminé!"
        );

        return;

    }


    /* =====================================================
       SPAWN
    ===================================================== */

    spawnTimer +=
        deltaTime * 1000;


    if (
        spawnTimer >=
        spawnInterval
    ) {

        spawnTimer -=
            spawnInterval;


        /*
            Ici, le jeu choisit automatiquement
            entre une boule de feu et une bombe.
        */

        spawnObject();


        /*
            Possibilité d'avoir un deuxième
            objet immédiatement.
        */

        if (
            Math.random() < 0.25
            &&
            (
                fireballs.length +
                bombs.length
            ) <
            MAX_FIREBALLS
        ) {

            spawnObject();

        }


        /*
            Accélération progressive.
        */

        spawnInterval =
            Math.max(

                MIN_SPAWN_INTERVAL,

                spawnInterval -
                SPAWN_ACCELERATION

            );

    }


    /* =====================================================
       BOULES DE FEU
    ===================================================== */

    for (
        const fireball
        of fireballs
    ) {

        fireball.update(
            deltaTime
        );

    }


    fireballs =
        fireballs.filter(
            fireball =>
                fireball.active
        );


    /* =====================================================
       BOMBES
    ===================================================== */

    for (
        const bomb
        of bombs
    ) {

        bomb.update(
            deltaTime
        );

    }


    bombs =
        bombs.filter(
            bomb =>
                bomb.active
        );


    /* =====================================================
       PARTICULES
    ===================================================== */

    updateParticles(
        deltaTime
    );


    updateSlashTrail(
        deltaTime
    );


    /* =====================================================
       AFFICHAGE
    ===================================================== */

    ctx.clearRect(

        0,
        0,

        window.innerWidth,
        window.innerHeight

    );


    /*
        Boules de feu.
    */

    for (
        const fireball
        of fireballs
    ) {

        fireball.draw();

    }


    /*
        Bombes.
    */

    for (
        const bomb
        of bombs
    ) {

        bomb.draw();

    }


    /*
        Particules.
    */

    drawParticles();


    /*
        Traînée.
    */

    drawSlashTrail();


    /*
        Frame suivante.
    */

    animationFrame =
        requestAnimationFrame(
            gameLoop
        );

}


/* =========================================================
   DÉMARRER UNE PARTIE
========================================================= */

function startGame() {

    /*
        Réinitialisation complète.
    */

    score = 0;

    lives = 1;

    fireballs = [];

    bombs = [];

    particles = [];

    slashTrail = [];


    /*
        Spawn.
    */

    spawnTimer = 0;

    spawnInterval =
        INITIAL_SPAWN_INTERVAL;


    /*
        Timer.
    */

    timeRemaining =
        GAME_DURATION;


    gameStartTime = 0;

    lastTimestamp = 0;


    /*
        Contrôles.
    */

    isDragging = false;

    previousPointer = null;


    /*
        État.
    */

    gameRunning = true;


    /*
        HUD.
    */

    updateHUD();


    /*
        Écrans.
    */

    homeScreen.classList.add(
        "hidden"
    );

    gameScreen.classList.remove(
        "hidden"
    );

    gameOverElement.classList.add(
        "hidden"
    );


    /*
        Curseur.
    */

    cursorDot.style.display =
        "block";


    /*
        Sécurité :
        annule une éventuelle ancienne boucle.
    */

    if (
        animationFrame !== null
    ) {

        cancelAnimationFrame(
            animationFrame
        );

    }


    animationFrame =
        requestAnimationFrame(
            function(timestamp) {

                gameStartTime =
                    timestamp;

                lastTimestamp =
                    timestamp;


                gameLoop(
                    timestamp
                );

            }
        );

}


/* =========================================================
   INITIALISATION
========================================================= */

homeScreen.classList.remove(
    "hidden"
);

gameScreen.classList.add(
    "hidden"
);

gameOverElement.classList.add(
    "hidden"
);

cursorDot.style.display =
    "none";


updateHUD();


/* =========================================================
   BOUTONS
========================================================= */

startButton.addEventListener(
    "click",
    startGame
);


restartButton.addEventListener(
    "click",
    startGame
);

</script>

