<!DOCTYPE html>
<html lang="fr">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Pêche Aquazo</title>

<style>

/* =========================================================
   BASE
========================================================= */

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;

    width: 100%;
    height: 100%;

    overflow: hidden;

    background: #000;

    font-family: Arial, sans-serif;
}


/* =========================================================
   JEU
========================================================= */

#game {

    position: fixed;

    inset: 0;

    width: 100vw;
    height: 100vh;

    overflow: hidden;

    background: #000;

    cursor: none;
}


/* =========================================================
   ÉCRAN D'ACCUEIL
========================================================= */

#startScreen {

    position: fixed;

    inset: 0;

    width: 100vw;
    height: 100vh;

    z-index: 1000;

    display: flex;

    justify-content: center;
    align-items: center;

    background: #000;

    overflow: hidden;
}

#startBackground {

    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;

    user-select: none;

    pointer-events: none;
}


/* =========================================================
   BOUTON COMMENCER
========================================================= */

#startButton {

    position: absolute;

    z-index: 2;

    bottom: 40px;

    left: 50%;

    transform: translateX(-50%);

    padding: 10px 32px;

    border: 3px solid white;

    border-radius: 10px;

    background: rgba(0, 0, 0, .75);

    color: white;

    font-size: 20px;

    font-weight: bold;

    cursor: pointer;

    transition:
        transform .15s ease,
        background .15s ease,
        color .15s ease;
}

#startButton:hover {

    transform:
        translateX(-50%)
        scale(1.06);

    background:
        rgba(255,255,255,.9);

    color: black;
}

#startButton:disabled {

    cursor: default;

    opacity: .7;
}


/* =========================================================
   TRANSITION — PLANCHE
========================================================= */

#transitionScreen {

    position: fixed;

    inset: 0;

    width: 100vw;
    height: 100vh;

    z-index: 900;

    display: none;

    overflow: hidden;

    pointer-events: none;

    background: transparent;
}

#transitionImage {

    position: absolute;

    left: 0;

    top: 0;

    width: 100vw;

    height: 100vh;

    object-fit: cover;

    transform:
        translateY(-100%);

    will-change:
        transform;
}


/*
   Animation :

   0%      = hors écran en haut
   33.33%  = arrive au centre
   66.66%  = reste 1 seconde
   100%    = repart vers le haut
*/

#transitionScreen.play #transitionImage {

    animation:
        transitionAnimation 3s ease-in-out forwards;
}

@keyframes transitionAnimation {

    0% {

        transform:
            translateY(-100%);
    }

    33.333% {

        transform:
            translateY(0);
    }

    66.666% {

        transform:
            translateY(0);
    }

    100% {

        transform:
            translateY(-100%);
    }
}


/* =========================================================
   DÉCOMPTE
========================================================= */

#countdownScreen {

    position: fixed;

    inset: 0;

    z-index: 800;

    display: none;

    justify-content: center;

    align-items: center;

    background: transparent;

    pointer-events: none;
}

#countdown {

    color: white;

    font-size: 120px;

    font-weight: 900;

    text-shadow:
        0 5px 15px rgba(0,0,0,.8);

    opacity: 0;

    line-height: 1;
}

.countdownAnimate {

    animation:
        countdownPop .8s ease-out forwards;
}

@keyframes countdownPop {

    0% {

        opacity: 0;

        transform:
            scale(1.6);
    }

    25% {

        opacity: 1;

        transform:
            scale(1);
    }

    75% {

        opacity: 1;

        transform:
            scale(1);
    }

    100% {

        opacity: 0;

        transform:
            scale(.8);
    }
}


/* =========================================================
   EAU / ARRIÈRE-PLAN
========================================================= */

#water {

    position: absolute;

    left: 0;
    top: 0;

    width: 100vw;

    will-change:
        transform;
}

#background {

    display: block;

    width: 100vw;

    height: auto;

    max-width: none;

    user-select: none;

    pointer-events: none;
}


/* =========================================================
   POISSONS
========================================================= */

.fish {

    position: absolute;

    width: 110px;
    height: 80px;

    object-fit: contain;

    transform:
        translate(-50%, -50%);

    pointer-events: none;

    z-index: 10;

    user-select: none;

    will-change:
        left,
        top,
        transform,
        opacity;

    transition:
        opacity .25s ease;
}


/* Poisson attrapé */

.fish.caught {

    opacity: 0;

    transform:
        translate(-50%, -50%)
        scale(1.8)
        rotate(20deg);
}


/* =========================================================
   LIGNE À PÊCHE
========================================================= */

#fishingLine {

    position: absolute;

    width: 3px;

    background: white;

    transform-origin:
        top center;

    z-index: 50;

    pointer-events: none;

    box-shadow:
        0 0 2px rgba(0,0,0,.8);
}


/* =========================================================
   HAMEÇON
========================================================= */

#hook {

    position: absolute;

    width: 24px;
    height: 32px;

    transform:
        translate(-50%, -4px);

    z-index: 51;

    pointer-events: none;
}

#hook::before {

    content: "";

    position: absolute;

    left: 10px;
    top: 0;

    width: 4px;
    height: 19px;

    background: #ddd;

    border-radius: 3px;
}

#hook::after {

    content: "";

    position: absolute;

    left: 5px;
    top: 14px;

    width: 14px;
    height: 14px;

    border:
        4px solid #ddd;

    border-top-color:
        transparent;

    border-left-color:
        transparent;

    border-radius:
        0 0 12px 0;

    transform:
        rotate(20deg);
}


/* =========================================================
   INTERFACE
========================================================= */

#ui {

    position: absolute;

    top: 20px;
    left: 50%;

    transform:
        translateX(-50%);

    display: flex;

    align-items: center;

    gap: 30px;

    padding: 10px 22px;

    background:
        rgba(0, 0, 0, .65);

    border-radius: 12px;

    color: white;

    font-size: 24px;

    font-weight: bold;

    z-index: 100;

    pointer-events: none;
}

#score {

    white-space: nowrap;
}

#timer {

    min-width: 35px;

    text-align: center;
}


/* =========================================================
   BULLES
========================================================= */

.bubble {

    position: fixed;

    width: 8px;
    height: 8px;

    border:
        2px solid rgba(255,255,255,.8);

    border-radius: 50%;

    pointer-events: none;

    z-index: 60;

    animation:
        bubbleUp 2s ease-out forwards;
}

@keyframes bubbleUp {

    0% {

        opacity: 1;

        transform:
            translateY(0)
            scale(.7);
    }

    100% {

        opacity: 0;

        transform:
            translateY(-80px)
            scale(1.3);
    }
}


/* =========================================================
   ÉCRAN DE FIN
========================================================= */

#endScreen {

    position: absolute;

    inset: 0;

    display: none;

    justify-content: center;

    align-items: center;

    flex-direction: column;

    background:
        rgba(0,0,0,.75);

    color: white;

    z-index: 200;

    text-align: center;
}

#endScreen h1 {

    margin:
        0 0 15px;

    font-size: 48px;
}

#finalScore {

    font-size: 28px;

    margin-bottom: 30px;
}

#restart {

    padding:
        14px 28px;

    border: none;

    border-radius: 10px;

    background: white;

    color: black;

    font-size: 20px;

    font-weight: bold;

    cursor: pointer;

    transition:
        transform .15s ease;
}

#restart:hover {

    transform:
        scale(1.05);
}

</style>
</head>


