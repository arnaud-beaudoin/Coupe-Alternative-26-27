<script>

/* =========================================================
   ÉLÉMENTS HTML
========================================================= */

const game =
    document.getElementById("game");

const water =
    document.getElementById("water");

const background =
    document.getElementById("background");

const fishingLine =
    document.getElementById("fishingLine");

const hook =
    document.getElementById("hook");

const scoreElement =
    document.getElementById("score");

const timerElement =
    document.getElementById("timer");

const endScreen =
    document.getElementById("endScreen");

const finalScore =
    document.getElementById("finalScore");

const restartButton =
    document.getElementById("restart");


/* =========================================================
   ÉCRAN D'ACCUEIL
========================================================= */

const startScreen =
    document.getElementById("startScreen");

const startButton =
    document.getElementById("startButton");

const transitionScreen =
    document.getElementById("transitionScreen");

const transitionImage =
    document.getElementById("transitionImage");

const countdownScreen =
    document.getElementById("countdownScreen");

const countdown =
    document.getElementById("countdown");


/* =========================================================
   POISSONS
========================================================= */

const fishes =
    Array.from(
        document.querySelectorAll(".fish")
    );


/* =========================================================
   VARIABLES DU JEU
========================================================= */

let score = 0;

let timeLeft = 20;

let gameRunning = false;

let gameStarted = false;

let mouseX =
    window.innerWidth / 2;

let mouseY =
    window.innerHeight / 2;

let waterY = 0;

let maxScroll = 0;

let startTime = 0;


/* =========================================================
   SOURIS
========================================================= */

document.addEventListener(
    "mousemove",
    function(event) {

        mouseX =
            event.clientX;

        mouseY =
            event.clientY;

    }
);


/* =========================================================
   CALCUL DU DÉFILEMENT
========================================================= */

function calculateScroll() {

    if (!background.complete) {
        return;
    }


    const imageHeight =
        background.getBoundingClientRect().height;


    maxScroll =
        Math.max(
            0,
            imageHeight -
            window.innerHeight
        );
}


/* =========================================================
   CHARGEMENT DE L'ARRIÈRE-PLAN
========================================================= */

background.addEventListener(
    "load",
    function() {

        calculateScroll();


        /*
         * Le jeu commence en bas de l'image.
         */

        waterY =
            -maxScroll;


        water.style.transform =
            `translateY(${waterY}px)`;

    }
);


/*
 * Si l'image était déjà en cache
 * au moment du lancement.
 */

if (background.complete) {

    calculateScroll();

    waterY =
        -maxScroll;

    water.style.transform =
        `translateY(${waterY}px)`;
}


/* =========================================================
   REDIMENSIONNEMENT
========================================================= */

window.addEventListener(
    "resize",
    function() {

        const oldMaxScroll =
            maxScroll;


        calculateScroll();


        /*
         * On conserve approximativement
         * la position actuelle lors d'un
         * changement de taille de fenêtre.
         */

        if (
            gameRunning &&
            oldMaxScroll > 0
        ) {

            const progress =
                1 -
                (
                    Math.abs(waterY) /
                    oldMaxScroll
                );


            waterY =
                -maxScroll +
                maxScroll * progress;


            water.style.transform =
                `translateY(${waterY}px)`;

        }

    }
);


/* =========================================================
   LIGNE ET HAMEÇON
========================================================= */

function updateHook() {

    const startX =
        window.innerWidth / 2;

    const startY =
        0;


    const hookX =
        mouseX;

    const hookY =
        mouseY;


    /*
     * Position du hameçon.
     */

    hook.style.left =
        `${hookX}px`;

    hook.style.top =
        `${hookY}px`;


    /*
     * Calcul de la longueur
     * de la ligne.
     */

    const dx =
        hookX -
        startX;

    const dy =
        hookY -
        startY;


    const length =
        Math.sqrt(
            dx * dx +
            dy * dy
        );


    /*
     * Angle de la ligne.
     */

    const angle =
        Math.atan2(dy, dx) -
        Math.PI / 2;


    fishingLine.style.left =
        `${startX - 1.5}px`;

    fishingLine.style.top =
        `${startY}px`;

    fishingLine.style.height =
        `${length}px`;

    fishingLine.style.transform =
        `rotate(${angle}rad)`;

}


/* =========================================================
   MOUVEMENT DES POISSONS
========================================================= */

function updateFishPositions() {

    const time =
        performance.now() / 1000;


    fishes.forEach(
        function(fish, index) {

            /*
             * Un poisson attrapé ne bouge plus.
             */

            if (
                fish.classList.contains("caught")
            ) {

                return;

            }


            const baseX =
                parseFloat(
                    fish.dataset.x
                );

            const baseY =
                parseFloat(
                    fish.dataset.y
                );


            /*
             * Vitesse selon la rareté.
             */

            let speed = 0.7;


            if (
                fish.classList.contains("rare")
            ) {

                speed = 1.15;

            }


            if (
                fish.classList.contains("galactic")
            ) {

                speed = 1.7;

            }


            /*
             * Mouvement horizontal.
             */

            let horizontalMove =
                Math.sin(
                    time *
                    speed +
                    index
                ) * 3;


            /*
             * Mouvement supplémentaire
             * pour les galactiques.
             */

            if (
                fish.classList.contains("galactic")
            ) {

                horizontalMove +=
                    Math.sin(
                        time *
                        2.4 +
                        index
                    ) * 2;

            }


            /*
             * Petit mouvement vertical.
             */

            const verticalMove =
                Math.sin(
                    time *
                    1.2 +
                    index *
                    1.7
                ) * 1.5;


            /*
             * Position.
             */

            fish.style.left =
                `${baseX + horizontalMove}%`;

            fish.style.top =
                `${baseY + verticalMove}%`;


            /*
             * Direction du poisson.
             */

            const direction =
                Math.cos(
                    time *
                    speed +
                    index
                ) >= 0
                    ? 1
                    : -1;


            fish.style.transform =
                `translate(-50%, -50%) scaleX(${direction})`;

        }
    );
}


/* =========================================================
   COLLISIONS
========================================================= */

function checkCollisions() {

    if (!gameRunning) {

        return;

    }


    const hookX =
        mouseX;

    const hookY =
        mouseY;


    fishes.forEach(
        function(fish) {

            if (
                fish.classList.contains("caught")
            ) {

                return;

            }


            const rect =
                fish.getBoundingClientRect();


            /*
             * Centre du poisson.
             */

            const fishX =
                rect.left +
                rect.width / 2;

            const fishY =
                rect.top +
                rect.height / 2;


            const dx =
                hookX -
                fishX;

            const dy =
                hookY -
                fishY;


            const distance =
                Math.sqrt(
                    dx * dx +
                    dy * dy
                );


            /*
             * Zone de capture.
             */

            if (distance < 42) {

                catchFish(fish);

            }

        }
    );
}


/* =========================================================
   ATTRAPER UN POISSON
========================================================= */

function catchFish(fish) {

    if (!gameRunning) {

        return;

    }


    let points = 1;


    if (
        fish.classList.contains("rare")
    ) {

        points = 2;

    }


    if (
        fish.classList.contains("galactic")
    ) {

        points = 5;

    }


    /*
     * Ajout des points.
     */

    score += points;


    scoreElement.textContent =
        `Poissons : ${score}`;


    /*
     * Marque le poisson comme attrapé.
     */

    fish.classList.add("caught");


    /*
     * Création des bulles.
     */

    const rect =
        fish.getBoundingClientRect();


    for (
        let i = 0;
        i < 3;
        i++
    ) {

        const bubble =
            document.createElement("div");


        bubble.className =
            "bubble";


        bubble.style.left =
            `${rect.left +
            Math.random() *
            rect.width}px`;


        bubble.style.top =
            `${rect.top +
            Math.random() *
            rect.height}px`;


        game.appendChild(
            bubble
        );


        setTimeout(
            function() {

                bubble.remove();

            },
            2000
        );

    }

}


/* =========================================================
   DÉFILEMENT DE L'IMAGE
========================================================= */

function updateWater() {

    if (!gameRunning) {

        return;

    }


    const elapsed =
        performance.now() -
        startTime;


    const progress =
        Math.min(
            elapsed / 20000,
            1
        );


    /*
     * Déplacement :
     *
     * début = bas de l'image
     * fin   = haut de l'image
     */

    waterY =
        -maxScroll +
        maxScroll *
        progress;


    water.style.transform =
        `translateY(${waterY}px)`;


    /*
     * Temps restant.
     */

    timeLeft =
        Math.max(
            0,
            Math.ceil(
                20 -
                elapsed / 1000
            )
        );


    timerElement.textContent =
        timeLeft;


    /*
     * Fin des 20 secondes.
     */

    if (elapsed >= 20000) {

        finishGame();

    }

}


/* =========================================================
   FIN DE LA PARTIE
========================================================= */

function finishGame() {

    if (!gameRunning) {

        return;

    }


    gameRunning =
        false;


    timeLeft = 0;


    timerElement.textContent =
        "0";


    finalScore.textContent =
        `Poissons attrapés : ${score}`;


    endScreen.style.display =
        "flex";

}


/* =========================================================
   RÉINITIALISATION DES POISSONS
========================================================= */

function resetFish() {

    fishes.forEach(
        function(fish) {

            fish.classList.remove(
                "caught"
            );

        }
    );

}


/* =========================================================
   DÉCOMPTE
========================================================= */

function showCountdown() {

    countdownScreen.style.display =
        "flex";


    const sequence = [
        "3",
        "2",
        "1",
        "GO!"
    ];


    let index = 0;


    function showNext() {

        countdown.textContent =
            sequence[index];


        /*
         * Redémarrage propre
         * de l'animation CSS.
         */

        countdown.classList.remove(
            "countdownAnimate"
        );


        void countdown.offsetWidth;


        countdown.classList.add(
            "countdownAnimate"
        );


        index++;


        if (
            index <
            sequence.length
        ) {

            setTimeout(
                showNext,
                1000
            );

        }

        else {

            /*
             * GO! reste affiché pendant
             * une seconde avant le départ.
             */

            setTimeout(
                function() {

                    countdownScreen.style.display =
                        "none";

                    startGame();

                },
                1000
            );

        }

    }


    showNext();

}


/* =========================================================
   DÉBUT D'UNE PARTIE
========================================================= */

function startGame() {

    /*
     * Réinitialisation complète.
     */

    score = 0;

    timeLeft = 20;

    gameRunning = true;

    gameStarted = true;


    /*
     * Interface.
     */

    scoreElement.textContent =
        "Poissons : 0";

    timerElement.textContent =
        "20";


    /*
     * Écran de fin.
     */

    endScreen.style.display =
        "none";


    /*
     * Poissons.
     */

    resetFish();


    /*
     * Calcul de la position
     * initiale de l'image.
     */

    calculateScroll();


    waterY =
        -maxScroll;


    water.style.transform =
        `translateY(${waterY}px)`;


    /*
     * Le chronomètre commence
     * exactement maintenant.
     */

    startTime =
        performance.now();

}


/* =========================================================
   BOUTON COMMENCER
========================================================= */

startButton.addEventListener(
    "click",
    function() {

        /*
         * Empêche les doubles clics.
         */

        startButton.disabled =
            true;


        /*
         * Cache l'écran d'accueil.
         */

        startScreen.style.display =
            "none";


        /*
         * Prépare la transition.
         */

        transitionScreen.style.display =
            "block";


        transitionScreen.classList.remove(
            "play"
        );


        /*
         * Force le navigateur à
         * recalculer l'animation.
         */

        void transitionScreen.offsetWidth;


        /*
         * Lance la transition.
         */

        transitionScreen.classList.add(
            "play"
        );


        /*
         * 3 secondes au total :
         *
         * 0 → 1 s : arrivée
         * 1 → 2 s : pause
         * 2 → 3 s : départ
         */

        setTimeout(
            function() {

                transitionScreen.style.display =
                    "none";


                transitionScreen.classList.remove(
                    "play"
                );


                /*
                 * Ensuite seulement,
                 * le décompte commence.
                 */

                showCountdown();

            },
            3000
        );

    }
);


/* =========================================================
   BOUTON REJOUER
========================================================= */

restartButton.addEventListener(
    "click",
    function() {

        /*
         * Retour à l'écran d'accueil
         * plutôt que de recommencer
         * immédiatement.
         */

        gameRunning =
            false;


        gameStarted =
            false;


        endScreen.style.display =
            "none";


        startButton.disabled =
            false;


        startScreen.style.display =
            "flex";


        /*
         * Réinitialisation visuelle.
         */

        score = 0;

        timeLeft = 20;


        scoreElement.textContent =
            "Poissons : 0";

        timerElement.textContent =
            "20";


        resetFish();


        calculateScroll();


        waterY =
            -maxScroll;


        water.style.transform =
            `translateY(${waterY}px)`;

    }
);


/* =========================================================
   BOUCLE PRINCIPALE
========================================================= */

function gameLoop() {

    updateHook();

    updateFishPositions();

    updateWater();

    checkCollisions();


    requestAnimationFrame(
        gameLoop
    );

}


/* =========================================================
   INITIALISATION
========================================================= */

calculateScroll();


if (maxScroll > 0) {

    waterY =
        -maxScroll;

    water.style.transform =
        `translateY(${waterY}px)`;

}


updateHook();


requestAnimationFrame(
    gameLoop
);

</script>

</body>
